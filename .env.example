# ===== Supabase (projeto próprio — Settings → API) =====
# Públicas: vão para o navegador (precisam existir também no BUILD da imagem)
VITE_SUPABASE_URL=https://SEU-PROJETO.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx
# Servidor
SUPABASE_URL=https://SEU-PROJETO.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx
SUPABASE_SERVICE_ROLE_KEY=sb_secret_xxx   # NUNCA expor no front

# ===== App =====
APP_URL=https://agenda.efcsys.com          # origem pública, sem barra no final
PORT=80

# ===== Google Calendar (Google Cloud Console → Credenciais → OAuth 2.0) =====
GOOGLE_OAUTH_CLIENT_ID=xxxx.apps.googleusercontent.com
GOOGLE_OAUTH_CLIENT_SECRET=GOCSPX-xxxx

# Chave de 32 bytes em base64 para cifrar os tokens do Google:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
APP_USER_CONNECTION_KEY_SECRET=

# Opcional (drizzle-kit)
DATABASE_URL=
