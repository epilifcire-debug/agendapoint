PORT=80

# ===== Google (OPCIONAL — desligado por padrão) =====
# Sem estas variáveis o app funciona só com o cadastro manual de shows,
# e o login é por e-mail e senha. Para ligar depois:
#   1) VITE_GOOGLE_ENABLED=true (também no BUILD da imagem)
#   2) preencher as três variáveis abaixo e ativar o provedor Google no Supabase
VITE_GOOGLE_ENABLED=false
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
# 32 bytes em base64: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
APP_USER_CONNECTION_KEY_SECRET=

# Opcional (drizzle-kit)
DATABASE_URL=
